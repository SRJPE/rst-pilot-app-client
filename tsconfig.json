{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsxImportSource": "nativewind",
    "allowSyntheticDefaultImports": true,
    "jsx": "react-native",
    "typeRoots": ["./src/types"],
    "paths": {
      "@/*": ["./*"],
      "tailwind.config": ["./tailwind.config.js"]
    }
  },
  "exclude": ["node_modules"]
}
