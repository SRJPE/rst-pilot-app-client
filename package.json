{
  "name": "rst-pilot-app",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "start-test": "expo start --go",
    "test": "vitest run",
    "test:watch": "vitest",
    "reset-cache": "expo start --clear",
    "android": "DARK_MODE=media expo run:android",
    "ios": "DARK_MODE=media expo run:ios",
    "web": "DARK_MODE=media expo start --web",
    "build-production": "EXPO_PUBLIC_BASE_URL=\"https://jpe-app-server-production.azurewebsites.net\" eas update --branch production",
    "build-testing": "EXPO_PUBLIC_BASE_URL=\"https://jpe-app-server.azurewebsites.net\" eas update --branch testing",
    "build-yolo-testing": "EXPO_PUBLIC_BASE_URL=\"https://jpe-app-server-ybfmp.azurewebsites.net\" eas update --branch yolo-testing",
    "build-dev": "EXPO_PUBLIC_BASE_URL=\"https://jpe-app-server.azurewebsites.net\" eas update --branch dev",
    "postinstall": "patch-package",
    "build-simulator": "eas build -p ios --profile development-simulator"
  },
