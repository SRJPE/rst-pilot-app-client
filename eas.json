{
  "cli": {
    "version": ">= 2.2.0"
  },
  "build": {
    "base": {
      "env": {}
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_BASE_URL": "https://jpe-app-server.azurewebsites.net"
      }
    },
    "preview-production": {
      "distribution": "internal",
      "channel": "production",
      "environment": "production",
      "ios": {
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_BASE_URL": "https://jpe-app-server-production.azurewebsites.net"
      }
    },
    "preview-testing": {
      "distribution": "internal",
      "channel": "testing",
      "environment": "preview",
      "ios": {
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_BASE_URL": "https://jpe-app-server.azurewebsites.net",
        "APP_VARIANT": "testing"
      }
    },
    "preview-yolo-testing": {
      "distribution": "internal",
      "channel": "yolo-testing",
      "environment": "preview",
      "ios": {
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_BASE_URL": "https://jpe-app-server-ybfmp.azurewebsites.net",
        "APP_VARIANT": "yolo"
      }
    },
    "preview-dev": {
      "distribution": "internal",
      "channel": "dev",
      "environment": "development",
      "ios": {
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_BASE_URL": "https://jpe-app-server.azurewebsites.net"
      }
    },
    "production": {},
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "devclient": {
      "extends": "base",
      "channel": "default",
      "distribution": "internal",
      "developmentClient": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true,
        "image": "latest",
        "autoIncrement": "version"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
